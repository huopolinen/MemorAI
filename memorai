#!/bin/bash
# MemorAI CLI — manage and inspect MemorAI data
# Usage: memorai <command> [args]

BUNDLE_ID="com.local.memorai"
if [ -d "/Applications/MemorAI.app" ]; then
    APP_PATH="/Applications/MemorAI.app"
else
    APP_PATH="$(dirname "$0")/MemorAI.app"
fi

# Local-engine model caches. Must match GigaAMModelStore.defaultModelDir and
# WhisperLocalEngine.defaultModelDir in the Swift sources.
GIGAAM_MODEL_DIR="$HOME/.local/share/gigaam-models"
GIGAAM_MODEL="$GIGAAM_MODEL_DIR/gigaam-v3-e2e-ctc-Q8_0.gguf"
GIGAAM_MODEL_URL="https://huggingface.co/handy-computer/gigaam-v3-e2e-ctc-gguf/resolve/075dff81f843cf23d22b4ce943ffdc4dd8650cd7/gigaam-v3-e2e-ctc-Q8_0.gguf?download=true"
GIGAAM_MODEL_SHA256="9ccce4750dc813a493d96ca15ee251712bedec15ac9a02fa3d2bd732f08ae5eb"
WHISPER_MODEL_DIR="$HOME/.local/share/whisper-models"

get_output_path() {
    local path
    path=$(defaults read "$BUNDLE_ID" outputPath 2>/dev/null)
    if [ -z "$path" ]; then
        path="$HOME/Downloads/MemorAI"
    fi
    echo "$path"
}

cmd_status() {
    local output
    output=$(get_output_path)
    echo "=== MemorAI Status ==="

    # Check if running
    if pgrep -f "MemorAI" > /dev/null 2>&1; then
        echo "App:              RUNNING"
    else
        echo "App:              NOT RUNNING"
    fi

    echo "Output:           $output"
    echo ""

    # Settings
    echo "--- Settings ---"
    local screen_mem=$(defaults read "$BUNDLE_ID" screenMemoryEnabled 2>/dev/null || echo "1")
    local clipboard=$(defaults read "$BUNDLE_ID" saveClipboard 2>/dev/null || echo "1")
    local interval=$(defaults read "$BUNDLE_ID" captureInterval 2>/dev/null || echo "3")
    local auto_detect=$(defaults read "$BUNDLE_ID" autoDetect 2>/dev/null || echo "1")
    local record_screen=$(defaults read "$BUNDLE_ID" recordScreen 2>/dev/null || echo "1")
    local auto_transcribe=$(defaults read "$BUNDLE_ID" autoTranscribe 2>/dev/null || echo "1")

    echo "Screen Memory:    $([ "$screen_mem" = "1" ] && echo ON || echo OFF)"
    echo "Save Clipboard:   $([ "$clipboard" = "1" ] && echo ON || echo OFF)"
    echo "Capture Interval: ${interval}s"
    echo "Auto-detect Calls:$([ "$auto_detect" = "1" ] && echo " ON" || echo " OFF")"
    echo "Record Screen:    $([ "$record_screen" = "1" ] && echo ON || echo OFF)"
    echo "Auto-transcribe:  $([ "$auto_transcribe" = "1" ] && echo ON || echo OFF)"
    echo ""

    echo "--- Transcription ---"
    local engine=$(defaults read "$BUNDLE_ID" transcriptionEngine 2>/dev/null)
    local language=$(defaults read "$BUNDLE_ID" whisperLanguage 2>/dev/null || echo "ru")
    if [ -z "$engine" ]; then
        # Mirrors SettingsManager: with no explicit choice, an existing whisper
        # setup keeps working and everyone else starts on GigaAM.
        if [ -n "$(ls "$WHISPER_MODEL_DIR"/ggml-*.bin 2>/dev/null)" ]; then
            engine="whisper_local (по умолчанию)"
        else
            engine="gigaam (по умолчанию)"
        fi
    fi
    echo "Engine:           $engine"
    echo "Language:         $language"
    if [ -f "$GIGAAM_MODEL" ]; then
        echo "GigaAM model:     installed ($(du -h "$GIGAAM_MODEL" | cut -f1))"
    else
        echo "GigaAM model:     NOT downloaded  (memorai model download)"
    fi
    local whisper_models=$(ls "$WHISPER_MODEL_DIR"/ggml-*.bin 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')
    echo "Whisper models:   ${whisper_models:-none}"
    echo ""

    # Excluded apps
    local excluded
    excluded=$(defaults read "$BUNDLE_ID" excludedBundleIds 2>/dev/null | grep '"' | sed 's/.*"\(.*\)".*/\1/')
    if [ -n "$excluded" ]; then
        echo "--- Excluded Apps ---"
        echo "$excluded" | while read -r bid; do
            echo "  $bid"
        done
        echo ""
    fi

    # Stats
    echo "--- Today's Data ---"
    local today=$(date +%Y-%m-%d)
    local screen_dir="$output/screen/$today"
    if [ -d "$screen_dir" ]; then
        local count=$(ls "$screen_dir"/*.json 2>/dev/null | wc -l | tr -d ' ')
        local size=$(du -sh "$screen_dir" 2>/dev/null | cut -f1)
        echo "Screenshots:      $count ($size)"
    else
        echo "Screenshots:      0"
    fi

    local clip_file="$output/clipboard.jsonl"
    if [ -f "$clip_file" ]; then
        local clip_count=$(wc -l < "$clip_file" | tr -d ' ')
        echo "Clipboard entries: $clip_count"
    else
        echo "Clipboard entries: 0"
    fi

    # Tracks are .caf while they are the only copy of a call and .m4a once
    # they have been archived after transcription — count both.
    local call_count=$(ls "$output"/call_*_mic.m4a "$output"/call_*_mic.caf \
                          "$output"/call_*_system.m4a "$output"/call_*_system.caf 2>/dev/null \
                       | sed -E 's/_(mic|system)\.(m4a|caf)$//' | sort -u | wc -l | tr -d ' ')
    echo "Call recordings:  $call_count"

    local pending
    pending=$(ls "$output"/call_*.meta.json 2>/dev/null | wc -l | tr -d ' ')
    if [ "$pending" != "0" ]; then
        echo ""
        cmd_sessions
    fi
}

# List recording sessions and what state each one is in, straight from the
# per-session meta.json markers the app writes.
cmd_sessions() {
    local output
    output=$(get_output_path)
    python3 - "$output" << 'PYEOF'
import glob, json, os, sys

folder = sys.argv[1]
rows = []
for path in sorted(glob.glob(os.path.join(folder, "call_*.meta.json"))):
    try:
        with open(path) as handle:
            meta = json.load(handle)
    except Exception:
        continue
    tag = meta.get("tag") or os.path.basename(path)[: -len(".meta.json")]
    status = meta.get("status", "?")
    files = meta.get("files", {})
    bytes_on_disk = 0
    for name in files.values():
        try:
            bytes_on_disk += os.path.getsize(os.path.join(folder, name))
        except OSError:
            pass
    transcript = os.path.join(folder, tag + "_transcript.txt")
    has_text = os.path.exists(transcript) and os.path.getsize(transcript) > 0
    note = []
    if meta.get("recovered"):
        note.append("recovered")
    if meta.get("compressed"):
        note.append("archived")
    if meta.get("transcription_failed"):
        note.append("no transcript")
    rows.append((tag, status, bytes_on_disk / 1048576, has_text, ", ".join(note)))

if not rows:
    print("No session markers yet (recordings made before 1.6 have none).")
    raise SystemExit

print("=== Sessions ===")
print(f"{'session':28s} {'status':12s} {'audio':>9s}  {'text':4s}  notes")
for tag, status, mb, has_text, note in rows:
    print(f"{tag:28s} {status:12s} {mb:8.1f}M  {'yes' if has_text else '—':4s}  {note}")

stuck = [r for r in rows if r[1] == "recording"]
if stuck:
    print()
    print("A session still marked 'recording' while the app is not running was")
    print("interrupted; the next launch of MemorAI will recover it automatically.")
PYEOF
}

# Find — and, on demand, repair — calls whose microphone track was recorded at
# the wrong speed.
#
# The damage: until 1.5.2 the mic file's sample rate was fixed by the first
# device of the session, and a device change mid-call (AirPods dropping to
# their 24 kHz voice mode) fed the new device's samples into it unconverted.
# The owner's half of such a call plays at double speed and transcribes as
# noise. 114 of 370 archived calls are affected.
#
# The repair is exact rather than approximate: the samples on disk are intact,
# only the rate they are labelled with is wrong, so re-labelling the affected
# span (asetrate) and resampling back undoes the damage sample for sample. A
# blanket atempo would instead time-stretch, and would be wrong for the calls
# where the device changed partway through — most of the file is fine there.
#
# Nothing is overwritten, ever: the result is a new `_mic_repaired.m4a` beside
# the original, which is the only copy of the conversation.
cmd_repair_speed() {
    local output apply=0 only_tag=""
    output=$(get_output_path)
    while [ $# -gt 0 ]; do
        case "$1" in
            --fix) apply=1 ;;
            --dir) output="$2"; shift ;;
            --tag) only_tag="$2"; shift ;;
            *) echo "Usage: memorai repair-speed [--fix] [--dir <folder>] [--tag <call_…>]"; return 1 ;;
        esac
        shift
    done
    if [ "$apply" = "1" ] && ! command -v ffmpeg > /dev/null 2>&1; then
        echo "ffmpeg is required to repair (brew install ffmpeg)"
        return 1
    fi
    python3 - "$output" "$apply" "$only_tag" << 'PYEOF'
import glob, os, re, subprocess, sys
from datetime import datetime, timezone

folder, apply, only_tag = sys.argv[1], sys.argv[2] == "1", sys.argv[3]

# A call shorter than this is not worth guessing about: a second of device
# warm-up is a large share of it, and half of it is not much to recover.
MIN_SYSTEM_SECONDS = 30.0
# mic/system below this is not a rounding difference. Measured over the 405
# archived calls with both tracks: healthy ones cluster at 0.95–1.05, damaged
# ones below 0.70, and the band 0.85–0.95 is empty.
SUSPECT_SHARE = 0.85
# Without log evidence, only a track that is half the far end's length end to
# end is repaired — that ratio has one plausible cause. Anything between the
# two clusters needs a human, because "the engine died halfway" looks the same
# from the outside and slowing it down would ruin it.
FLAT_LOW, FLAT_HIGH = 0.45, 0.55
# How far the length the log predicts may sit from the length on disk before we
# stop believing the log explains this file. The gap of a restart (a fraction
# of a second, unpadded before 1.6) and the log's one-second timestamps are the
# whole of the expected error.
LOG_TOLERANCE = 0.05


def probe(path, entries):
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", entries,
             "-of", "default=nw=1:nk=1", path],
            capture_output=True, text=True, timeout=60)
        return out.stdout.split()
    except Exception:
        return []


def duration(path):
    values = probe(path, "format=duration")
    return float(values[0]) if values else None


def file_rate(path):
    """The sample rate the track's own header declares — which is the one the
    audio is *played* at, and therefore the one the damage is measured against.
    Read from the file rather than the log because the two disagree exactly
    where it matters: 1.4.0/1.4.1 hardcoded the file at 48 kHz no matter what
    the engine was capturing."""
    values = probe(path, "stream=sample_rate")
    return int(values[0]) if values else None


def track(tag, role):
    for ext in ("caf", "m4a"):
        path = os.path.join(folder, f"{tag}_{role}.{ext}")
        if os.path.exists(path):
            return path
    return None


# --- What the log knows -----------------------------------------------------
#
# Every session's mic engine announces the format it is capturing in, both when
# it starts and on every restart. That is the whole story of this bug written
# down: the first rate is the one the file's header got, and any later rate is
# a span that went in mislabelled.
STAMP = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)Z ")
STARTED = re.compile(r"\[MicRecorder\] Recording started → (call_\S+?)_mic\.")
# The line has been worded four ways across the versions that wrote this
# archive, and every one of them states the rate the engine is capturing at
# first: "Engine started: 24000Hz, 1ch", "…: input 24000Hz/1ch → file
# 48000Hz/1ch", "…: probe 48000Hz/1ch", "Engine started on <device>:
# 48000Hz/1ch".
ENGINE = re.compile(r"\[MicRecorder\] Engine started[^:]*:\s*(?:probe\s+|input\s+)?(\d+)\s*Hz")
STOPPED = re.compile(r"\[MicRecorder\] Recording stopped")


def parse_log():
    path = os.path.join(folder, "memorai.log")
    sessions, open_tag, segments, pending = {}, None, [], None
    if not os.path.exists(path):
        return sessions
    with open(path, errors="replace") as handle:
        for line in handle:
            stamp = STAMP.match(line)
            if not stamp:
                continue
            when = datetime.strptime(stamp.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)
            engine = ENGINE.search(line)
            if engine:
                entry = (when, int(engine.group(1)))
                if open_tag:
                    segments.append(entry)
                else:
                    # The start-up line lands just before "Recording started".
                    pending = entry
                continue
            start = STARTED.search(line)
            if start:
                open_tag = start.group(1)
                segments = [pending] if pending else []
                pending = None
                continue
            if STOPPED.search(line) and open_tag:
                if segments:
                    sessions[open_tag] = (segments, when)
                open_tag, segments = None, []
    return sessions


def plan_from_log(entry, mic_seconds, rate_on_disk):
    """File-time spans and the rate each was really captured at, or None."""
    segments, ended = entry
    bounds, at = [], 0.0
    for i, (when, rate) in enumerate(segments):
        until = segments[i + 1][0] if i + 1 < len(segments) else ended
        real = (until - when).total_seconds()
        if real <= 0:
            continue
        span = real * rate / rate_on_disk
        bounds.append((at, at + span, rate))
        at += span
    if not bounds or at <= 0:
        return None
    if abs(at - mic_seconds) / mic_seconds > LOG_TOLERANCE:
        return None          # the log does not describe the file on disk
    if all(rate == rate_on_disk for _, _, rate in bounds):
        return None          # nothing was mislabelled; the track is short for another reason
    # The last span ends where the audio ends, whatever the arithmetic says.
    bounds[-1] = (bounds[-1][0], mic_seconds, bounds[-1][2])
    return bounds


def repair(src, dst, file_rate, bounds):
    chains, labels = [], []
    for i, (start, end, rate) in enumerate(bounds):
        chain = f"[0:a]atrim={start:.4f}:{end:.4f},asetpts=N/SR/TB"
        if rate != file_rate:
            # The samples are fine; only the rate they were filed under is
            # wrong. Re-label, then resample back to the file's rate.
            chain += f",asetrate={rate},aresample={file_rate}"
        chains.append(chain + f"[p{i}]")
        labels.append(f"[p{i}]")
    graph = ";".join(chains) + ";" + "".join(labels) + f"concat=n={len(bounds)}:v=0:a=1[out]"
    cmd = ["ffmpeg", "-nostdin", "-v", "error", "-i", src,
           "-filter_complex", graph, "-map", "[out]",
           "-c:a", "aac", "-b:a", "64k", dst]
    done = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
    if done.returncode != 0:
        if os.path.exists(dst):
            os.remove(dst)
        return done.stderr.strip().splitlines()[-1] if done.stderr.strip() else "ffmpeg failed"
    return None


log_sessions = parse_log()
tags = sorted({
    os.path.basename(p).rsplit("_mic.", 1)[0]
    for ext in ("caf", "m4a")
    for p in glob.glob(os.path.join(folder, f"call_*_mic.{ext}"))
})
if only_tag:
    tags = [t for t in tags if t == only_tag]

found, repaired, skipped, recovered = [], 0, [], 0.0
for tag in tags:
    mic, system = track(tag, "mic"), track(tag, "system")
    if not mic or not system:
        continue                     # one-sided recording: nothing to compare against
    mic_seconds, system_seconds = duration(mic), duration(system)
    if not mic_seconds or not system_seconds or system_seconds < MIN_SYSTEM_SECONDS:
        continue
    share = mic_seconds / system_seconds
    if share >= SUSPECT_SHARE:
        continue

    rate = file_rate(mic)
    bounds = (plan_from_log(log_sessions[tag], mic_seconds, rate)
              if tag in log_sessions and rate else None)
    if bounds:
        rates = "→".join(str(r) for _, _, r in bounds)
        why = f"log: captured at {rates} Hz, filed as {rate} Hz"
    elif rate and FLAT_LOW <= share <= FLAT_HIGH:
        bounds = [(0.0, mic_seconds, rate // 2)]
        why = "no usable log entry — inferred from the 2:1 length ratio alone"
    else:
        skipped.append((tag, share, "length ratio is off but nothing explains it — look at this one by hand"))
        continue

    dst = os.path.join(folder, f"{tag}_mic_repaired.m4a")
    transcript = os.path.join(folder, f"{tag}_transcript.txt")
    note = "transcript exists (left alone)" if os.path.exists(transcript) else "no transcript"
    if os.path.exists(dst):
        skipped.append((tag, share, "already repaired — " + os.path.basename(dst) + " is there"))
        continue

    found.append((tag, mic_seconds, system_seconds, share, why, note))
    if apply:
        error = repair(mic, dst, rate, bounds)
        if error:
            print(f"  ❌ {tag}: {error}")
        else:
            repaired += 1
            recovered += (duration(dst) or 0) - mic_seconds

print(f"=== Mic tracks recorded at the wrong speed ({folder}) ===")
if not found and not skipped:
    print("Nothing suspicious: every call's mic track matches the far end's length.")
for tag, mic_s, sys_s, share, why, note in found:
    print(f"  {tag}  mic {mic_s/60:6.1f}m vs far end {sys_s/60:6.1f}m  ({share:.2f}×)")
    print(f"      {why}; {note}")
    print(f"      → {tag}_mic_repaired.m4a")
if skipped:
    print()
    print("Left alone:")
    for tag, share, why in skipped:
        print(f"  {tag}  ({share:.2f}×)  {why}")
print()
if apply:
    print(f"Repaired {repaired} of {len(found)}; "
          f"{recovered/60:.0f} minutes of speech given their real length back.")
    print("Originals untouched. Transcripts untouched — re-run transcription yourself")
    print("if you want the repaired tracks turned into text.")
else:
    print(f"{len(found)} call(s) would be repaired. Nothing has been changed.")
    print("Run  memorai repair-speed --fix  to write the repaired tracks.")
PYEOF
}

cmd_screenshots() {
    local output=$(get_output_path)
    local today=$(date +%Y-%m-%d)
    local day="${1:-$today}"
    local screen_dir="$output/screen/$day"

    if [ ! -d "$screen_dir" ]; then
        echo "No screenshots for $day"
        return
    fi

    echo "=== Screenshots for $day ==="
    for f in "$screen_dir"/*.json; do
        [ -f "$f" ] || continue
        python3 -c "
import json, sys
d = json.load(open('$f'))
ts = d.get('timestamp','')[:19]
app = d.get('app_name','')
title = d.get('window_title','')[:50] if d.get('window_title') else ''
ocr = d.get('ocr_text','')[:80].replace('\n',' ')
print(f'{ts}  {app:20s}  {title}')
" 2>/dev/null
    done
}

cmd_clipboard() {
    local output=$(get_output_path)
    local clip_file="$output/clipboard.jsonl"
    local count="${1:-20}"

    if [ ! -f "$clip_file" ]; then
        echo "No clipboard history"
        return
    fi

    echo "=== Clipboard History (last $count) ==="
    tail -n "$count" "$clip_file" | python3 -c "
import sys, json
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try:
        d = json.loads(line)
        ts = d.get('timestamp','')[:19]
        app = d.get('app_name','')
        typ = d.get('type','')
        content = d.get('content','')[:80].replace('\n',' ')
        print(f'{ts}  {app:20s}  [{typ:5s}]  {content}')
    except: pass
"
}

cmd_ocr() {
    local output=$(get_output_path)
    local today=$(date +%Y-%m-%d)
    local day="${1:-$today}"
    local screen_dir="$output/screen/$day"
    local count="${2:-5}"

    if [ ! -d "$screen_dir" ]; then
        echo "No data for $day"
        return
    fi

    echo "=== OCR Text (last $count from $day) ==="
    ls "$screen_dir"/*.json 2>/dev/null | tail -n "$count" | while read f; do
        python3 -c "
import json
d = json.load(open('$f'))
ts = d.get('timestamp','')[:19]
app = d.get('app_name','')
ocr = d.get('ocr_text','')[:200]
print(f'--- {ts} [{app}] ---')
print(ocr)
print()
" 2>/dev/null
    done
}

cmd_set() {
    local key="$1"
    local value="$2"

    case "$key" in
        screen-memory)
            defaults write "$BUNDLE_ID" screenMemoryEnabled -bool "$value"
            echo "Screen Memory: $value"
            ;;
        clipboard)
            defaults write "$BUNDLE_ID" saveClipboard -bool "$value"
            echo "Save Clipboard: $value"
            ;;
        interval)
            defaults write "$BUNDLE_ID" captureInterval -float "$value"
            echo "Capture Interval: ${value}s"
            ;;
        auto-detect)
            defaults write "$BUNDLE_ID" autoDetect -bool "$value"
            echo "Auto-detect Calls: $value"
            ;;
        engine)
            case "$value" in
                gigaam|whisper_local|groq|gemini) ;;
                *)
                    echo "Unknown engine: $value"
                    echo "Available: gigaam, whisper_local, groq, gemini"
                    return 1
                    ;;
            esac
            defaults write "$BUNDLE_ID" transcriptionEngine -string "$value"
            echo "Transcription engine: $value"
            if [ "$value" = "gigaam" ] && [ ! -f "$GIGAAM_MODEL" ]; then
                echo "⚠️  Модель GigaAM не скачана — запусти: memorai model download"
            fi
            ;;
        language)
            defaults write "$BUNDLE_ID" whisperLanguage -string "$value"
            echo "Language: $value"
            ;;
        *)
            echo "Unknown setting: $key"
            echo "Available: screen-memory, clipboard, interval, auto-detect, engine, language"
            return 1
            ;;
    esac
    echo "(Restart app to apply)"
}

cmd_exclude() {
    local action="$1"
    local bundle_id="$2"

    case "$action" in
        add)
            if [ -z "$bundle_id" ]; then
                echo "Usage: memorai exclude add <bundle-id>"
                return 1
            fi
            local current
            current=$(defaults read "$BUNDLE_ID" excludedBundleIds 2>/dev/null || echo "()")
            defaults write "$BUNDLE_ID" excludedBundleIds -array-add "$bundle_id"
            echo "Added $bundle_id to exclusions"
            ;;
        remove)
            if [ -z "$bundle_id" ]; then
                echo "Usage: memorai exclude remove <bundle-id>"
                return 1
            fi
            # Read current, filter out the one to remove, write back
            local items
            items=$(defaults read "$BUNDLE_ID" excludedBundleIds 2>/dev/null | grep '"' | sed 's/.*"\(.*\)".*/\1/' | grep -v "^${bundle_id}$")
            if [ -z "$items" ]; then
                defaults write "$BUNDLE_ID" excludedBundleIds -array
            else
                local args=""
                while IFS= read -r item; do
                    args="$args $item"
                done <<< "$items"
                defaults write "$BUNDLE_ID" excludedBundleIds -array $args
            fi
            echo "Removed $bundle_id from exclusions"
            ;;
        list)
            defaults read "$BUNDLE_ID" excludedBundleIds 2>/dev/null | grep '"' | sed 's/.*"\(.*\)".*/  \1/'
            ;;
        *)
            echo "Usage: memorai exclude <add|remove|list> [bundle-id]"
            ;;
    esac
}

cmd_model() {
    local action="${1:-status}"

    case "$action" in
        status)
            if [ -f "$GIGAAM_MODEL" ]; then
                echo "GigaAM: installed  $GIGAAM_MODEL ($(du -h "$GIGAAM_MODEL" | cut -f1))"
            else
                echo "GigaAM: not downloaded  ($GIGAAM_MODEL)"
            fi
            echo "Whisper: $(ls "$WHISPER_MODEL_DIR"/ggml-*.bin 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
            ;;
        download)
            if [ -f "$GIGAAM_MODEL" ]; then
                echo "Already downloaded: $GIGAAM_MODEL"
                return 0
            fi
            mkdir -p "$GIGAAM_MODEL_DIR"
            echo "Downloading GigaAM v3 (~260 MB)…"
            # Into .partial, verified, then renamed — same contract as the app,
            # so a killed download never leaves a file the app would trust.
            curl -L --fail --progress-bar -o "$GIGAAM_MODEL.partial" "$GIGAAM_MODEL_URL" || {
                rm -f "$GIGAAM_MODEL.partial"
                echo "❌ Download failed"
                return 1
            }
            local got
            got=$(shasum -a 256 "$GIGAAM_MODEL.partial" | cut -d' ' -f1)
            if [ "$got" != "$GIGAAM_MODEL_SHA256" ]; then
                rm -f "$GIGAAM_MODEL.partial"
                echo "❌ Checksum mismatch ($got) — file corrupted, try again"
                return 1
            fi
            mv "$GIGAAM_MODEL.partial" "$GIGAAM_MODEL"
            echo "✅ GigaAM model ready: $GIGAAM_MODEL"
            ;;
        remove)
            rm -f "$GIGAAM_MODEL"
            echo "Removed $GIGAAM_MODEL"
            ;;
        *)
            echo "Usage: memorai model <status|download|remove>"
            return 1
            ;;
    esac
}

cmd_start() {
    if pgrep -f "MemorAI" > /dev/null 2>&1; then
        echo "MemorAI is already running"
    else
        open "$APP_PATH"
        echo "MemorAI started"
    fi
}

# Find the running app (the bundle's own binary, not this script and not some
# unrelated process whose command line happens to mention MemorAI).
app_pids() {
    pgrep -f "MemorAI.app/Contents/MacOS/MemorAI" 2>/dev/null || pgrep -x "MemorAI" 2>/dev/null
}

any_alive() {
    local pid
    for pid in $1; do
        kill -0 "$pid" 2>/dev/null && return 0
    done
    return 1
}

cmd_stop() {
    local pids
    pids=$(app_pids)
    if [ -z "$pids" ]; then
        echo "MemorAI is not running"
        return 0
    fi

    # SIGTERM, never SIGKILL first. The app catches it, stops the recorders and
    # closes the audio tracks before exiting. A SIGKILL skips all of that: the
    # recording itself still survives (it is uncompressed PCM on purpose), but
    # it comes back as an interrupted session that has to be recovered on the
    # next launch instead of simply being finished now.
    echo "Stopping MemorAI…"
    kill -TERM $pids 2>/dev/null

    # The app gives itself 20 s to finish a recording before it gives up; wait
    # a little longer than that before concluding it is genuinely wedged.
    local waited=0
    while [ $waited -lt 25 ]; do
        sleep 1
        waited=$((waited + 1))
        if ! any_alive "$pids"; then
            echo "MemorAI stopped cleanly (${waited}s)"
            return 0
        fi
    done

    echo "MemorAI did not exit in ${waited}s — forcing it."
    echo "If a call was being recorded, it will be recovered on the next launch."
    kill -9 $pids 2>/dev/null
    sleep 1
    any_alive "$pids" && echo "Still running — check Activity Monitor" || echo "MemorAI killed"
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_help() {
    cat << 'EOF'
MemorAI — remembers everything you do on your computer

Usage: memorai <command> [args]

Commands:
  status                    Show app status, settings, and today's stats
  start                     Start MemorAI
  stop                      Stop MemorAI
  restart                   Restart MemorAI

  sessions                  List call sessions and their processing state
  repair-speed [--fix]      Find calls whose mic track was recorded at double
                            speed (device changed mid-call) and, with --fix,
                            write a corrected copy beside each original
    --dir <folder>          Look somewhere other than the recordings folder
    --tag call_<timestamp>  Only this one session
  screenshots [date]        List today's screenshots (or given YYYY-MM-DD)
  clipboard [count]         Show clipboard history (default: last 20)
  ocr [date] [count]        Show OCR text from screenshots

  model <status|download|remove>
                            Manage the local GigaAM model (~260 MB)

  set <key> <value>         Change a setting
    screen-memory true/false
    clipboard true/false
    interval <seconds>
    auto-detect true/false
    engine gigaam|whisper_local|groq|gemini
    language ru|en|auto

  exclude add <bundle-id>   Add app to exclusion list
  exclude remove <bundle-id>  Remove app from exclusion list
  exclude list              List excluded apps

  help                      Show this help
EOF
}

# Main dispatcher
case "${1:-help}" in
    status)       cmd_status ;;
    start)        cmd_start ;;
    stop)         cmd_stop ;;
    restart)      cmd_restart ;;
    sessions)     cmd_sessions ;;
    repair-speed) shift; cmd_repair_speed "$@" ;;
    screenshots)  cmd_screenshots "$2" ;;
    clipboard)    cmd_clipboard "$2" ;;
    ocr)          cmd_ocr "$2" "$3" ;;
    model)        cmd_model "$2" ;;
    set)          cmd_set "$2" "$3" ;;
    exclude)      cmd_exclude "$2" "$3" ;;
    help|--help|-h) cmd_help ;;
    *)            echo "Unknown command: $1"; cmd_help ;;
esac
